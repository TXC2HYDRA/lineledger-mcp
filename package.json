{
  "name": "lineledger-mcp",
  "version": "0.0.0",
  "description": "LineLedger — Factory-Floor Co-pilot: a voice-first assistant backed by a self-hosted MCP server (synthetic demo data).",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "preflight:mcp": "tsx scripts/mcp-preflight.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "dev:server": "tsx server/main.ts",
    "report": "tsx scripts/shift-report.ts",
    "dynamodb:local-table": "tsx scripts/dynamodb.ts create-local",
    "dynamodb:seed": "tsx scripts/dynamodb.ts seed",
    "test": "vitest run",
    "test:dynamodb": "LINELEDGER_TEST_DYNAMODB_ENDPOINT=${LINELEDGER_TEST_DYNAMODB_ENDPOINT:-http://127.0.0.1:8000} vitest run",
    "dev:web": "vite",
    "build": "vite build",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "dev:agent": ".venv/bin/python agent/service.py",
    "test:agent": ".venv/bin/python -m unittest discover -s agent -v"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1155.0",
    "@aws-sdk/client-sns": "3.1155.0",
    "@aws-sdk/lib-dynamodb": "3.1155.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "container-load-planner": "git+https://github.com/TXC2HYDRA/container-load-planner.git#3c4fe91",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
