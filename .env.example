# LineLedger local settings. Local, non-secret values only.
# Copy to .env and adjust. Nothing here is a credential.

# MCP server (Streamable HTTP endpoint is http://127.0.0.1:${SERVER_PORT}${MCP_PATH})
SERVER_PORT=3000
MCP_PATH=/mcp

# Web client (Vite dev server)
WEB_PORT=5173

# Agent service
AGENT_PORT=8000
# local-model = Strands agent with a local Ollama model; rule-based = deterministic planner, no LLM
AGENT_MODE=rule-based

# Local model server (loopback only). Model tag is chosen after the Phase 0b spike.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# SQLite file for handover notes and follow-ups (git-ignored data directory)
DB_PATH=./data/lineledger.sqlite
