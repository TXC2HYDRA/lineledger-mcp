# LineLedger local settings. Local, non-secret values only.
# Copy to .env and adjust. Nothing here is a credential.

# MCP server (Streamable HTTP endpoint is http://127.0.0.1:${SERVER_PORT}${MCP_PATH})
SERVER_PORT=3000
MCP_PATH=/mcp

# Web client (Vite dev server)
WEB_PORT=5173

# Agent service
AGENT_PORT=8000
# local-model = Strands agent with a local Ollama model; rule-based = deterministic planner, no LLM
AGENT_MODE=rule-based

# Local model server (loopback only). Model tag is chosen after the Phase 0b spike.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# SQLite file for handover notes and follow-ups (git-ignored data directory)
DB_PATH=./data/lineledger.sqlite

# ---- Optional AWS integrations (all off by default; see README "AWS integrations") ----------------
# Store: sqlite (default) or dynamodb
LINELEDGER_STORE=sqlite
# DynamoDB Local for development and tests (loopback only). Leave empty to use the real table on AWS.
LINELEDGER_DYNAMODB_ENDPOINT=
LINELEDGER_DYNAMODB_TABLE=lineledger
# Agent model provider: ollama (default) or bedrock (Amazon Nova only)
LINELEDGER_MODEL_PROVIDER=ollama
LINELEDGER_BEDROCK_MODEL=us.amazon.nova-lite-v1:0
LINELEDGER_AWS_REGION=us-east-1
# Alerts: none (default) or sns. The topic is created by scripts/deploy-report.sh (stack output TopicArn).
LINELEDGER_NOTIFY=none
LINELEDGER_SNS_TOPIC_ARN=
# Self-hosted alerts (LINELEDGER_NOTIFY=local, and the fallback when SNS fails): JSONL file plus optional webhook
LINELEDGER_ALERT_FILE=data/alerts.jsonl
LINELEDGER_WEBHOOK_URL=
# Self-hosted fallbacks on AWS failure (DynamoDB -> SQLite, Bedrock -> Ollama, SNS -> local alerts). off disables them.
LINELEDGER_FALLBACK=on
# Real AWS paths start only with the project profile. Point these at files OUTSIDE the repository:
#   AWS_CONFIG_FILE=$HOME/.aws-lineledger/config
#   AWS_SHARED_CREDENTIALS_FILE=$HOME/.aws-lineledger/credentials
#   AWS_PROFILE=lineledger
# Never put access keys in this file.
